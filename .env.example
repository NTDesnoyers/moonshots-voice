# Optional. The app runs without any keys (browser speech + scripted coach).
# Copy to .env or .env.local for a higher-quality upgrade.

# Stream grounded coach replies (preferred if set)
OPENAI_API_KEY=

# Used if OPENAI_API_KEY is absent
ANTHROPIC_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
OPENAI_TRANSCRIBE_MODEL=whisper-1
